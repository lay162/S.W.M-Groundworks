# Copy to ".env" for local dev. For production, set the same names in GitHub → Settings → Secrets and variables → Actions.

# Public mailto fallback (embedded at build time; not secret).
VITE_BUSINESS_QUOTE_EMAIL="quotes@swm-groundworks.co.uk"

# Google Sheets via Apps Script (browser POST — required for quote form on the built site).
# Live deployment (S.W.M Quote Log, Version 2) — also saved in GITHUB-PAGES-HOSTING.txt for GitHub Actions.
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxYrMoNcaqToRiw7PxOqQYPdOP-nj-jDtusxXwwLZYj4Fm-adBZFRcr-GK2jRhTd-Pu/exec"
# Must match var SECRET inside Code.gs (see FOR-GOOGLE-APPS-SCRIPT-PASTE-ONLY.txt).
VITE_GOOGLE_APPS_SCRIPT_SECRET="swm-groundworks-quote-2026"

# Optional: "true" to send photo base64 to Apps Script (Drive upload path in script). Large uploads may hit limits.
VITE_GOOGLE_APPS_SCRIPT_INCLUDE_PHOTOS="false"
